#!/usr/bin/env bash
# SPDX-FileCopyrightText: 2026 Bart van de Lint
# SPDX-License-Identifier: AGPL-3.0-or-later
# Starts Julia on this repo's project for a person at a terminal; arguments pass through.
set -euo pipefail

repo=$(dirname "${BASH_SOURCE[0]}")/..
major=$("$repo/bin/julia_version")

exec julia "+$major" --project="$repo" -t auto "$@"
