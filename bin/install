#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.."

usage() {
    cat <<'USAGE'
Usage: bin/install [-y] [--update] [-h]

Copy each tracked Manifest-v<version>.toml.default, in the package and in scripts/, over
its live manifest, then instantiate and precompile. Uses the active Julia where a manifest
is tracked for it, and otherwise the newest installed juliaup channel that has one. Changes
nothing outside the repository except the packages and caches in the Julia depot.

  -y, --yes   never prompt; this script never does, so the flag only says so
  --update    Pkg.update against the live manifests; the .default files stay as they are
  -h, --help  show this message
USAGE
}

update=false
while [ $# -gt 0 ]; do
    case "$1" in
        -y|--yes) ;;
        --update) update=true ;;
        -h|--help) usage; exit 0 ;;
        *) echo "bin/install: unknown option $1" >&2; usage >&2; exit 1 ;;
    esac
    shift
done

minor_version() {
    "$@" --startup-file=no -e 'print(VERSION.major, ".", VERSION.minor)' 2>/dev/null || true
}

julia_command=(julia)
version=$(minor_version julia)
if [ ! -f "Manifest-v$version.toml.default" ]; then
    version=""
    for default in $(ls -r Manifest-v*.toml.default); do
        tracked=${default#Manifest-v}
        tracked=${tracked%.toml.default}
        if [ "$(minor_version julia "+$tracked")" = "$tracked" ]; then
            version=$tracked
            julia_command=(julia "+$tracked")
            break
        fi
    done
fi
if [ -z "$version" ]; then
    echo "bin/install: no installed Julia has a tracked manifest." >&2
    exit 1
fi
echo "Installing for Julia $version with ${julia_command[*]}"

for environment in . scripts; do
    manifest="$environment/Manifest-v$version.toml"
    [ -f "$manifest.default" ] || continue
    if $update; then
        steps='using Pkg; Pkg.update(); Pkg.precompile(; strict=true)'
    else
        cp "$manifest.default" "$manifest"
        steps='using Pkg; Pkg.instantiate(); Pkg.precompile(; strict=true)'
    fi
    "${julia_command[@]}" --startup-file=no --project="$environment" -e "$steps"
done
