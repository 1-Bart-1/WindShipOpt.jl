#!/usr/bin/env bash
# SPDX-FileCopyrightText: 2026 Bart van de Lint
# SPDX-License-Identifier: AGPL-3.0-or-later
# Serve the companion explorer in site/ on http://localhost:5173, installing its packages
# from the lockfile first where they are missing. Arguments go to Vite, e.g. --port 8080.
set -euo pipefail
cd "$(dirname "$0")/../site"
[[ -d node_modules ]] || npm ci
exec npm run dev -- "$@"
