\@writefile{lof}{\contentsline {figure}{\numberline {S4}{\ignorespaces Frames and angles of the kite model. (a) The wind window seen from the tow point looking downwind: the kite at roll angle $\phi $ and angle $\vartheta $ off downwind, the unit vectors $\hat  {\mathbf  e}_\vartheta $ towards the edge of the window and $\hat  {\mathbf  e}_\phi $ along the roll, and the heading $\hat  {\mathbf  h}$ at the angle $\psi $ between them. The shaded wedge is a band of roll angles $\phi _0\pm \phi _a$ a pattern sweeps; no part of a pattern flies in the grey band below the lowest elevation. (b) The same seen from the side. (c) Seen from above, the mean tether force $\overline  {\mathbf  F}$ and its components along and across a course $\chi $ off the apparent downwind direction; the kite pulls the ship forward wherever the force leans ahead of the beam of that course.}}{7}{figure.4}\protected@file@percent }
\newlabel{fig:kite_frames}{{S4}{7}{Frames and angles of the kite model. (a) The wind window seen from the tow point looking downwind: the kite at roll angle $\phi $ and angle $\vartheta $ off downwind, the unit vectors $\hat {\mathbf e}_\vartheta $ towards the edge of the window and $\hat {\mathbf e}_\phi $ along the roll, and the heading $\hat {\mathbf h}$ at the angle $\psi $ between them. The shaded wedge is a band of roll angles $\phi _0\pm \phi _a$ a pattern sweeps; no part of a pattern flies in the grey band below the lowest elevation. (b) The same seen from the side. (c) Seen from above, the mean tether force $\overline {\mathbf F}$ and its components along and across a course $\chi $ off the apparent downwind direction; the kite pulls the ship forward wherever the force leans ahead of the beam of that course}{figure.4}{}}
\newlabel{fig:kite_frames@cref}{{[figure][4][]S4}{[1][7][]7}{}{}{}}
